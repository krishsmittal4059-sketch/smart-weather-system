[Unit]
Description=Smart Weather System Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/smart-weather-system
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smart-weather-system/venv/bin/python /opt/smart-weather-system/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
