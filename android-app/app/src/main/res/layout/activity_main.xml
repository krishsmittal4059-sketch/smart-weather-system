<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#f2f5f7">
<LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:text="Smart Weather" android:textSize="30sp" android:textStyle="bold" android:textColor="#17202a" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:text="Raspberry Pi + BME280" android:textSize="16sp" android:textColor="#64748b" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="18dp"/>
<LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
<EditText android:id="@+id/ipInput" android:hint="Pi IP address" android:text="192.168.1.100" android:inputType="textUri" android:layout_weight="1" android:layout_width="0dp" android:layout_height="wrap_content"/>
<Button android:id="@+id/connectButton" android:text="Connect" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
</LinearLayout>
<TextView android:id="@+id/status" android:text="Enter your Pi IP and tap Connect" android:textSize="15sp" android:layout_marginTop="12dp" android:layout_marginBottom="12dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/temp" android:text="🌡 Temperature: -- °C" android:textSize="22sp" android:padding="18dp" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/humidity" android:text="💧 Humidity: -- %" android:textSize="22sp" android:padding="18dp" android:layout_marginTop="10dp" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/pressure" android:text="🌬 Pressure: -- hPa" android:textSize="22sp" android:padding="18dp" android:layout_marginTop="10dp" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/altitude" android:text="⛰ Altitude: -- m" android:textSize="22sp" android:padding="18dp" android:layout_marginTop="10dp" android:background="#ffffff" android:layout_width="match_parent" android:layout_height="wrap_content"/>
<TextView android:id="@+id/updated" android:text="Last update: --" android:textSize="14sp" android:textColor="#64748b" android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout></ScrollView>
