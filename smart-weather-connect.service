[Unit]
Description=Smart Weather System for Raspberry Pi Connect
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/smart_weather_system
ExecStart=/usr/bin/python3 /home/pi/smart_weather_system/connect_weather.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
